    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst seen = new Set();\nconst cleaned = [];\n\nfor (const item of rows) {\n  const row = Object.fromEntries(\n    Object.entries(item.json).map(([key, value]) => [\n      key.trim(),\n      typeof value === 'string' ? value.trim() : value,\n    ])\n  );\n\n  // Buang baris yang seluruh kolomnya kosong\n  if (Object.values(row).every(value =>\n    value === null || value === undefined || value === ''\n  )) {\n    continue;\n  }\n\n  // Buang baris duplikat yang seluruh nilainya sama\n  const signature = JSON.stringify(row);\n  if (seen.has(signature)) continue;\n\n  seen.add(signature);\n  cleaned.push({ json: row });\n}\n\nreturn cleaned;"
      },
